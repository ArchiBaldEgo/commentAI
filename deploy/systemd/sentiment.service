[Unit]
Description=Sentiment API Service
After=network.target

[Service]
WorkingDirectory=/opt/sentiment
EnvironmentFile=/opt/sentiment/.env
ExecStart=/opt/sentiment/.venv/bin/uvicorn src.sentiment.api:app --host 0.0.0.0 --port 8000
Restart=always
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
