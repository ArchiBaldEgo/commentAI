# Security
API_KEY=change_me

# Online learning (hybrid)
ONLINE_LEARNING=1
ONLINE_BATCH_SIZE=16
ONLINE_BATCH_INTERVAL_SECONDS=30
ONLINE_MAX_LOAD=4.0

# Auto retrain
AUTO_RETRAIN_ENABLED=1
AUTO_RETRAIN_INTERVAL_SECONDS=600
AUTO_RETRAIN_MIN_ITEMS=50

# Rate limit
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WHITELIST=/health,/metrics

# Storage: file | db (db uses SQLAlchemy DB_URL, defaults to local SQLite if empty)
STORAGE_MODE=file
DB_URL=

# Postgres (used by docker-compose.postgres.yml)
PG_DB=sentiment
PG_USER=sentiment
PG_PASSWORD=sentiment

# MySQL (used by docker-compose.mysql.yml)
MYSQL_DB=sentiment
MYSQL_USER=sentiment
MYSQL_PASSWORD=sentiment
MYSQL_ROOT_PASSWORD=root
